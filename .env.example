# Server-only secrets; never commit values or put them in VITE_*.
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet.solana.com
# Remote/production Postgres URL must use ?sslmode=verify-full.
DATABASE_URL=
# Optional trusted server CA PEM from provider; actual newlines or literal \n are supported.
DATABASE_CA_CERT=
# One-off migration process only. Remove admin credentials from the running service environment.
DATABASE_MIGRATION_URL=
DATABASE_MIGRATION_CA_CERT=
SESSION_SECRET=
FEE_ENCRYPTION_KEY=
BACKUP_DIRECTORY=
BACKUP_ENCRYPTION_KEY=
RPC_MONTHLY_CREDIT_CAP=900000
BETA_INVITE_WALLETS=
PROGRAM_ID=
PROGRAM_VERIFIED=false
PROGRAM_EXPECTED_SHA256=
PROGRAM_UPGRADE_AUTHORITY=
BETA_LOOKUP_TABLE=
MAINNET_CANARY_VERIFIED=false
CANARY_APPROVED=false
CANARY_OWNER=
KEEPER_ENABLED=false
OPERATOR_KILL_SWITCH=true
SERVICE_BUDGET_EXHAUSTED=false
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# Public build-time addresses only; must match reviewed deployment.
VITE_PROGRAM_ID=
VITE_SOLANA_CLUSTER=mainnet-beta
VITE_OWNER_RPC_URL=
