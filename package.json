{
  "name": "doubletake",
  "private": true,
  "version": "2.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "test": "tsx --test tests/*.test.js tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "test:program": "wsl -d Ubuntu -- bash onchain/scripts/test.sh"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.28",
    "@solana/wallet-adapter-phantom": "0.9.30",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/wallet-adapter-solflare": "0.6.34",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.4",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "bigint-buffer": "file:vendor/bigint-buffer"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/bn.js": "5.2.0",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=22.22.2 <25"
  },
  "overrides": {
    "jayson": "5.0.0",
    "bigint-buffer": "$bigint-buffer",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1"
  }
}
