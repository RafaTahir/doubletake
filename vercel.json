{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "redirects": [
    {
      "source": "/",
      "destination": "https://doubletake-production-446f.up.railway.app/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://doubletake-production-446f.up.railway.app/:path*",
      "permanent": false
    }
  ],
  "functions": {
    "api/public-workspace.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/public-workspace?route=:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/product-beta": false
    }
  }
}
